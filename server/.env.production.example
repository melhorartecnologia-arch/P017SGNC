# Modelo de variáveis de ambiente para PRODUÇÃO.
# Copie para server/.env no servidor e preencha os valores reais.
#   cp server/.env.production.example server/.env && nano server/.env

# Banco PostgreSQL local. Use a senha definida ao criar o usuário no Postgres.
DATABASE_URL="postgresql://sgnc:SENHA_FORTE_DO_BANCO@localhost:5432/sgnc?schema=public"

# A API fica atrás do Nginx; só 80/443 são expostos. Mantenha 3333.
PORT=3333
NODE_ENV=production

# Domínio público (mesma origem do front). Usado pelo CORS.
CORS_ORIGIN=https://seu-dominio.com.br

# Gere um segredo longo e aleatório:  openssl rand -hex 32
JWT_SECRET="TROQUE_POR_UM_SEGREDO_LONGO_E_ALEATORIO"
JWT_EXPIRES_IN=43200

# Admin criado pelo seed na primeira execução. TROQUE a senha antes de subir!
ADMIN_EMAIL="admin@cervejariacidadeimperial.com.br"
ADMIN_PASSWORD="TROQUE_ESTA_SENHA"
ADMIN_NOME="Administrador"
