generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UsuarioRole {
  ADMIN
  USUARIO
}

/// Usuário do sistema — autenticação por e-mail + senha.
model Usuario {
  id             String      @id @default(uuid()) @db.Uuid
  email          String      @unique @db.VarChar(160)
  senhaHash      String      @map("senha_hash") @db.VarChar(120)
  nome           String      @db.VarChar(120)
  role           UsuarioRole @default(USUARIO)
  ativo          Boolean     @default(true)
  filialPadraoId String?     @map("filial_padrao_id") @db.Uuid

  filialPadrao              Filial?                    @relation(fields: [filialPadraoId], references: [id], onDelete: SetNull)
  relatoriosNaoConformidade RelatorioNaoConformidade[]
  enviosAssinatura          RncEnvioAssinatura[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([filialPadraoId])
  @@map("usuarios")
}

/// Fornecedor — pessoa jurídica que fornece insumos, produtos ou serviços.
model Fornecedor {
  id           String  @id @default(uuid()) @db.Uuid
  codigo       String  @unique @db.VarChar(20)
  razaoSocial  String  @map("razao_social") @db.VarChar(160)
  nomeFantasia String? @map("nome_fantasia") @db.VarChar(160)
  cnpj         String  @unique @db.VarChar(18)
  ativo        Boolean @default(true)
  observacoes  String? @db.Text
  origemCadastro OrigemCadastro @default(PLATAFORMA) @map("origem_cadastro")

  contatos                  ContatoFornecedor[]
  relatoriosNaoConformidade RelatorioNaoConformidade[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([razaoSocial])
  @@map("fornecedores")
}

enum ContatoTipo {
  TELEFONE_FIXO
  WHATSAPP
  EMAIL
}

/// Origem do cadastro: integrado do ERP Protheus (ETL) ou criado na plataforma.
enum OrigemCadastro {
  PROTHEUS
  PLATAFORMA
}

/// Contato vinculado a um fornecedor. Cada fornecedor pode ter vários.
model ContatoFornecedor {
  id           String      @id @default(uuid()) @db.Uuid
  fornecedorId String      @map("fornecedor_id") @db.Uuid
  tipo         ContatoTipo
  valor        String      @db.VarChar(160)
  nome         String?     @db.VarChar(120)
  principal    Boolean     @default(false)

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([fornecedorId])
  @@index([fornecedorId, tipo])
  @@map("contatos_fornecedor")
}

/// Severidade — classificação da gravidade de uma não conformidade.
model Severidade {
  id        String  @id @default(uuid()) @db.Uuid
  codigo    String  @unique @db.VarChar(20)
  nome      String  @db.VarChar(80)
  nivel     Int     @unique
  cor       String? @db.VarChar(7) // ex.: "#dc2626"
  descricao String? @db.Text
  ativo     Boolean @default(true)

  tiposRelatorio            TipoRelatorio[]
  tiposNaoConformidade      TipoNaoConformidade[]
  relatoriosNaoConformidade RelatorioNaoConformidade[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("severidades")
}

/// Tipo de Relatório — categoria de relatório emitido pelo sistema
/// (ex.: RNC, RAQ, RHE, RVT).
model TipoRelatorio {
  id        String  @id @default(uuid()) @db.Uuid
  codigo    String  @unique @db.VarChar(20)
  descricao String  @db.VarChar(160)
  ativo     Boolean @default(true)

  severidades Severidade[]
  origens     OrigemNaoConformidade[]
  disposicoes DisposicaoMaterial[]
  politica    PoliticaResposta?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([descricao])
  @@map("tipos_relatorio")
}

/// Política de Resposta — define a quantidade de horas contínuas em que
/// um relatório de determinado tipo precisa ser assinado/respondido.
model PoliticaResposta {
  id              String  @id @default(uuid()) @db.Uuid
  tipoRelatorioId String  @unique @map("tipo_relatorio_id") @db.Uuid
  horasResposta   Int     @map("horas_resposta")
  descricao       String? @db.Text
  ativo           Boolean @default(true)

  tipoRelatorio TipoRelatorio @relation(fields: [tipoRelatorioId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("politicas_resposta")
}

/// Turno de Trabalho — horário das equipes de uma filial
/// (ex.: Manhã 06:00–14:00). Cada filial mantém seu próprio conjunto
/// de turnos, então o código só precisa ser único dentro da filial.
model TurnoTrabalho {
  id          String  @id @default(uuid()) @db.Uuid
  filialId    String  @map("filial_id") @db.Uuid
  codigo      String  @db.VarChar(20)
  nome        String  @db.VarChar(80)
  horaInicio  String  @map("hora_inicio") @db.VarChar(5)
  horaFim     String  @map("hora_fim") @db.VarChar(5)
  descricao   String? @db.Text
  ativo       Boolean @default(true)

  filial                    Filial                     @relation(fields: [filialId], references: [id], onDelete: Restrict)
  aprovadores               Aprovador[]
  relatoriosNaoConformidade RelatorioNaoConformidade[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([filialId, codigo], name: "turno_unico_por_filial")
  @@index([filialId])
  @@index([nome])
  @@map("turnos_trabalho")
}

/// Produto — item de catálogo (matéria-prima, insumo, produto acabado, etc.).
model Produto {
  id             String  @id @default(uuid()) @db.Uuid
  codigo         String  @unique @db.VarChar(20)
  descricao      String  @db.VarChar(160)
  unidadeMedida  String  @map("unidade_medida") @db.VarChar(10)
  ativo          Boolean @default(true)
  origemCadastro OrigemCadastro @default(PLATAFORMA) @map("origem_cadastro")

  tiposNaoConformidade      TipoNaoConformidade[]
  relatoriosNaoConformidade RelatorioNaoConformidade[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([descricao])
  @@map("produtos")
}

/// Tipo de Não Conformidade — categoria do desvio identificado
/// (ex.: dimensional, contaminação, etiqueta, etc.). Pode estar
/// vinculado a um ou mais produtos.
model TipoNaoConformidade {
  id            String  @id @default(uuid()) @db.Uuid
  codigo        String  @unique @db.VarChar(20)
  descricao     String  @db.VarChar(160)
  severidadeId  String? @map("severidade_id") @db.Uuid
  ativo         Boolean @default(true)

  produtos                  Produto[]
  severidade                Severidade?                @relation(fields: [severidadeId], references: [id], onDelete: SetNull)
  relatoriosNaoConformidade RelatorioNaoConformidade[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([descricao])
  @@index([severidadeId])
  @@map("tipos_nao_conformidade")
}

/// Disposição do Material — destino dado ao material objeto da não conformidade
/// (ex.: Retrabalho, Sucata, Aceitar sob concessão, Devolver ao fornecedor).
model DisposicaoMaterial {
  id        String  @id @default(uuid()) @db.Uuid
  codigo    String  @unique @db.VarChar(20)
  descricao String  @db.VarChar(160)
  ativo     Boolean @default(true)

  tiposRelatorio            TipoRelatorio[]
  relatoriosNaoConformidade RelatorioNaoConformidade[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([descricao])
  @@map("disposicoes_material")
}

/// Origem da Não Conformidade — fonte/causa primária do registro
/// (ex.: Auditoria, Cliente, Inspeção, Processo).
model OrigemNaoConformidade {
  id        String  @id @default(uuid()) @db.Uuid
  codigo    String  @unique @db.VarChar(20)
  nome      String  @db.VarChar(120)
  descricao String? @db.Text
  ativo     Boolean @default(true)

  tiposRelatorio            TipoRelatorio[]
  relatoriosNaoConformidade RelatorioNaoConformidade[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([nome])
  @@map("origens_nao_conformidade")
}

/// Filial — unidade produtora (fábrica) da Cervejaria Cidade Imperial.
model Filial {
  id          String  @id @default(uuid()) @db.Uuid
  codigo      String  @unique @db.VarChar(20)
  nome        String  @db.VarChar(120)
  razaoSocial String  @map("razao_social") @db.VarChar(160)
  cnpj        String  @unique @db.VarChar(18)
  endereco    String  @db.VarChar(200)
  numero      String? @db.VarChar(20)
  complemento String? @db.VarChar(60)
  bairro      String? @db.VarChar(80)
  cidade      String  @db.VarChar(80)
  uf          String  @db.Char(2)
  cep         String  @db.VarChar(10)
  ativo       Boolean @default(true)
  observacoes String? @db.Text

  // Numeração sequencial de RNC por filial: ponto de partida informado no
  // cadastro (último número do controle atual). As novas RNCs continuam daqui.
  rncNumeroInicial Int @default(0) @map("rnc_numero_inicial")

  aprovadores               Aprovador[]
  turnos                    TurnoTrabalho[]
  relatoriosNaoConformidade RelatorioNaoConformidade[]
  usuariosFilialPadrao      Usuario[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([nome])
  @@index([cidade, uf])
  @@map("filiais")
}

/// Área — agrupamento organizacional (Produção, Qualidade, etc.).
/// Cadastro global; aparece em todas as filiais via Aprovador.
model Area {
  id        String  @id @default(uuid()) @db.Uuid
  codigo    String  @unique @db.VarChar(20)
  nome      String  @db.VarChar(120)
  descricao String? @db.Text
  ativo     Boolean @default(true)

  aprovadores Aprovador[]
  rncAprovadores RncAprovador[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([nome])
  @@map("areas")
}

/// Aprovador de uma (Filial × Área).
model Aprovador {
  id          String  @id @default(uuid()) @db.Uuid
  filialId    String  @map("filial_id") @db.Uuid
  areaId      String  @map("area_id") @db.Uuid
  turnoId     String? @map("turno_id") @db.Uuid
  nivel       Int
  nome        String  @db.VarChar(120)
  cargo       String? @db.VarChar(120)
  email       String  @db.VarChar(160)
  telefone    String? @db.VarChar(20)
  whatsapp    String? @db.VarChar(20)
  ativo       Boolean @default(true)
  observacoes String? @db.Text

  filial Filial         @relation(fields: [filialId], references: [id], onDelete: Restrict)
  area   Area           @relation(fields: [areaId], references: [id], onDelete: Restrict)
  turno  TurnoTrabalho? @relation(fields: [turnoId], references: [id], onDelete: SetNull)

  rncAprovadores RncAprovador[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([filialId, areaId, nivel], name: "aprovador_unico_por_nivel")
  @@index([filialId])
  @@index([areaId])
  @@index([filialId, areaId])
  @@map("aprovadores")
}

enum RncStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  CLOSED
  CANCELLED
}

/// Relatório de Não Conformidade (RNC) — registro principal de
/// não conformidade detectada com um fornecedor. Construído por
/// etapas (wizard): inicia em status DRAFT e amadurece a cada
/// etapa preenchida.
model RelatorioNaoConformidade {
  id                    String    @id @default(uuid()) @db.Uuid
  numero                String    @unique @db.VarChar(40)
  /// Sequência contínua da RNC dentro da filial (base da numeração).
  sequencialFilial      Int?      @map("sequencial_filial")
  filialId              String    @map("filial_id") @db.Uuid
  fornecedorId          String    @map("fornecedor_id") @db.Uuid
  tipoNaoConformidadeId String    @map("tipo_nao_conformidade_id") @db.Uuid
  turnoId               String?   @map("turno_id") @db.Uuid
  disposicaoMaterialId  String?   @map("disposicao_material_id") @db.Uuid
  origemId              String?   @map("origem_id") @db.Uuid
  severidadeId          String?   @map("severidade_id") @db.Uuid
  descricaoDefeito      String?   @map("descricao_defeito") @db.Text
  dataIdentificacao     DateTime  @map("data_identificacao")
  status                RncStatus @default(DRAFT)
  criadoPorId           String    @map("criado_por_id") @db.Uuid

  // Workflow de assinatura / SLA (Política de Resposta)
  assinaturaEnviadaEm DateTime? @map("assinatura_enviada_em")
  escalonadoEm        DateTime? @map("escalonado_em")
  assinaturasConcluidasEm DateTime? @map("assinaturas_concluidas_em")

  // Material & lote
  produtoId          String?   @map("produto_id") @db.Uuid
  quantidadeDefeito  Float?    @map("quantidade_defeito")
  tempoParadaMinutos Int?      @map("tempo_parada_minutos")

  // Transporte
  transportador  String? @db.VarChar(160)
  placaCavalo    String? @map("placa_cavalo") @db.VarChar(10)
  placaCarreta   String? @map("placa_carreta") @db.VarChar(10)
  nomeMotorista  String? @map("nome_motorista") @db.VarChar(120)
  cnhMotorista   String? @map("cnh_motorista") @db.VarChar(20)

  filial              Filial                 @relation(fields: [filialId], references: [id], onDelete: Restrict)
  fornecedor          Fornecedor             @relation(fields: [fornecedorId], references: [id], onDelete: Restrict)
  tipoNaoConformidade TipoNaoConformidade    @relation(fields: [tipoNaoConformidadeId], references: [id], onDelete: Restrict)
  turno               TurnoTrabalho?         @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  disposicaoMaterial  DisposicaoMaterial?    @relation(fields: [disposicaoMaterialId], references: [id], onDelete: SetNull)
  origem              OrigemNaoConformidade? @relation(fields: [origemId], references: [id], onDelete: SetNull)
  severidade          Severidade?            @relation(fields: [severidadeId], references: [id], onDelete: SetNull)
  produto             Produto?               @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  criadoPor           Usuario                @relation(fields: [criadoPorId], references: [id], onDelete: Restrict)
  fotos               RncFoto[]
  lotes               RncLote[]
  notasFiscais        RncNotaFiscal[]
  aprovadores         RncAprovador[]
  enviosAssinatura    RncEnvioAssinatura[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([filialId])
  @@index([fornecedorId])
  @@index([tipoNaoConformidadeId])
  @@index([disposicaoMaterialId])
  @@index([origemId])
  @@index([severidadeId])
  @@index([produtoId])
  @@index([status])
  @@map("relatorios_nao_conformidade")
}

/// Foto anexada a um Relatório de Não Conformidade. O arquivo físico
/// é armazenado em disco (server/uploads/rnc-fotos/{filename}).
model RncFoto {
  id           String  @id @default(uuid()) @db.Uuid
  rncId        String  @map("rnc_id") @db.Uuid
  filename     String  @db.VarChar(120)
  originalName String  @map("original_name") @db.VarChar(255)
  mimeType     String  @map("mime_type") @db.VarChar(80)
  size         Int
  legenda      String? @db.VarChar(200)

  rnc RelatorioNaoConformidade @relation(fields: [rncId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([rncId])
  @@map("rnc_fotos")
}

/// Lote informado em um Relatório de Não Conformidade. Uma RNC
/// pode ter múltiplos lotes — o conjunto (rncId, numero) é único
/// para evitar duplicidade dentro do mesmo registro.
model RncLote {
  id         String @id @default(uuid()) @db.Uuid
  rncId      String @map("rnc_id") @db.Uuid
  numero     String @db.VarChar(80)
  quantidade Float?

  rnc RelatorioNaoConformidade @relation(fields: [rncId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([rncId, numero])
  @@index([rncId])
  @@map("rnc_lotes")
}

/// Nota fiscal vinculada a um Relatório de Não Conformidade. Uma RNC
/// pode ter várias notas, cada uma com suas próprias datas de
/// fabricação, validade e recebimento.
model RncNotaFiscal {
  id              String    @id @default(uuid()) @db.Uuid
  rncId           String    @map("rnc_id") @db.Uuid
  numero          String?   @db.VarChar(40)
  dataFabricacao  DateTime? @map("data_fabricacao")
  dataValidade    DateTime? @map("data_validade")
  dataRecebimento DateTime? @map("data_recebimento")

  rnc RelatorioNaoConformidade @relation(fields: [rncId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([rncId])
  @@map("rnc_notas_fiscais")
}

enum SmtpSeguranca {
  NONE
  SSL
  TLS
}

/// Configuração técnica do servidor SMTP usado pelo serviço de workflow
/// (notificações e aprovações por e-mail). Tabela de linha única — a
/// aplicação sempre lê/grava o registro de id 1.
model ConfiguracaoSmtp {
  id             Int           @id @default(1)
  host           String        @db.VarChar(160)
  porta          Int           @default(587)
  seguranca      SmtpSeguranca @default(TLS)
  usuario        String?       @db.VarChar(160)
  senha          String?       @db.VarChar(255)
  remetenteNome  String        @map("remetente_nome") @db.VarChar(120)
  remetenteEmail String        @map("remetente_email") @db.VarChar(160)
  ativo          Boolean       @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("configuracoes_smtp")
}

/// Matriz de aprovação de uma RNC — quem deve assinar o documento.
/// Uma pessoa por área cadastrada em Aprovador para a filial da RNC;
/// quando o aprovador tem restrição de turno, vale apenas para RNCs
/// do turno correspondente. Os campos de texto são um retrato do
/// cadastro no momento da montagem da matriz.
model RncAprovador {
  id          String  @id @default(uuid()) @db.Uuid
  rncId       String  @map("rnc_id") @db.Uuid
  aprovadorId String? @map("aprovador_id") @db.Uuid
  areaId      String? @map("area_id") @db.Uuid
  areaNome    String  @map("area_nome") @db.VarChar(120)
  nome           String    @db.VarChar(120)
  cargo          String?   @db.VarChar(120)
  email          String?   @db.VarChar(160)
  whatsapp       String?   @db.VarChar(20)
  nivel          Int?
  assinadoEm     DateTime? @map("assinado_em")
  tokenAssinatura String?  @unique @map("token_assinatura") @db.VarChar(64)
  senhaAssinatura String?  @map("senha_assinatura") @db.VarChar(6)
  lembreteEnviadoEm DateTime? @map("lembrete_enviado_em")
  viaEscalonamento  Boolean   @default(false) @map("via_escalonamento")

  // Metadados técnicos capturados no momento da assinatura.
  assinaturaIp        String? @map("assinatura_ip") @db.VarChar(64)
  assinaturaUserAgent String? @map("assinatura_user_agent") @db.Text
  assinaturaNavegador String? @map("assinatura_navegador") @db.VarChar(120)
  assinaturaSo        String? @map("assinatura_so") @db.VarChar(120)
  assinaturaDispositivo String? @map("assinatura_dispositivo") @db.VarChar(120)
  assinaturaLatitude  Float?  @map("assinatura_latitude")
  assinaturaLongitude Float?  @map("assinatura_longitude")
  assinaturaPrecisao  Float?  @map("assinatura_precisao")
  assinaturaMetadados Json?   @map("assinatura_metadados")

  rnc       RelatorioNaoConformidade @relation(fields: [rncId], references: [id], onDelete: Cascade)
  aprovador Aprovador?               @relation(fields: [aprovadorId], references: [id], onDelete: SetNull)
  area      Area?                    @relation(fields: [areaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([rncId])
  @@map("rnc_aprovadores")
}

/// Log de cada envio de um RNC para assinatura (workflow). Permite
/// rastrear o histórico de disparos do workflow de assinatura.
model RncEnvioAssinatura {
  id                 String   @id @default(uuid()) @db.Uuid
  rncId              String   @map("rnc_id") @db.Uuid
  rncNumero          String   @map("rnc_numero") @db.VarChar(40)
  enviadoPorId       String?  @map("enviado_por_id") @db.Uuid
  enviadoPorNome     String   @map("enviado_por_nome") @db.VarChar(120)
  totalDestinatarios Int      @map("total_destinatarios")
  destinatarios      Json     // [{ email, areaNome, nome }]
  enviadoEm          DateTime @default(now()) @map("enviado_em")

  rnc        RelatorioNaoConformidade @relation(fields: [rncId], references: [id], onDelete: Cascade)
  enviadoPor Usuario?                 @relation(fields: [enviadoPorId], references: [id], onDelete: SetNull)

  @@index([rncId])
  @@index([rncNumero])
  @@index([enviadoEm])
  @@map("rnc_envios_assinatura")
}
