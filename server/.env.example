# Conexão PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sgnc?schema=public"

# Servidor HTTP
PORT=3333
CORS_ORIGIN=http://localhost:5173

# Autenticação
# Troque por uma string longa e aleatória em produção.
JWT_SECRET="dev-secret-trocar-em-producao"
# Duração do token (em segundos) — padrão 12h.
JWT_EXPIRES_IN=43200

# Usuário administrador criado pelo seed na primeira execução.
ADMIN_EMAIL="admin@sgnc.local"
ADMIN_PASSWORD="admin123"
ADMIN_NOME="Administrador"

# Integração bSynapse — correção de texto por IA (opcional).
# Sem essas variáveis, o botão "Corrigir texto com IA" informa que o
# recurso não está configurado.
# BSYNAPSE_API_URL="https://bsynapse.cervejariacidadeimperial.com/api/v1/analyze/corretor-ortografia"
# BSYNAPSE_API_KEY="sua-chave-aqui"
# Defina como 1 para logar a resposta crua da bSynapse (diagnóstico do formato).
# BSYNAPSE_DEBUG=1

# Integração WhatsApp (Twilio) — opcional. Sem ACCOUNT_SID/AUTH_TOKEN, o
# envio por WhatsApp é ignorado (o e-mail continua funcionando).
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="seu-auth-token"
# Remetente WhatsApp (número Twilio aprovado). Padrão: 551150289997
# TWILIO_WHATSAPP_FROM="551150289997"
# Content SIDs dos templates aprovados (já vêm com os valores padrão):
# TWILIO_TEMPLATE_SOLICITACAO="HXbb97bd0544af7415b65d99e94f6507bf"
# TWILIO_TEMPLATE_LEMBRETE="HXed47968ad61dad39b959eed3f8f45dc3"
# TWILIO_TEMPLATE_CONCLUIDA="HXd9f3902e52bd71a2fea1c97d3dcad97f"
