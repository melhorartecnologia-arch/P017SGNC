# Conexão PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sgnc?schema=public"

# Servidor HTTP
PORT=3333
CORS_ORIGIN=http://localhost:5173

# Autenticação
# Troque por uma string longa e aleatória em produção.
JWT_SECRET="dev-secret-trocar-em-producao"
# Duração do token (em segundos) — padrão 12h.
JWT_EXPIRES_IN=43200

# Usuário administrador criado pelo seed na primeira execução.
ADMIN_EMAIL="admin@sgnc.local"
ADMIN_PASSWORD="admin123"
ADMIN_NOME="Administrador"

# Integração bSynapse — correção de texto por IA (opcional).
# Sem essas variáveis, o botão "Corrigir texto com IA" informa que o
# recurso não está configurado.
# BSYNAPSE_API_URL="https://bsynapse.cervejariacidadeimperial.com/api/v1/analyze/corretor-ortografia"
# BSYNAPSE_API_KEY="sua-chave-aqui"
